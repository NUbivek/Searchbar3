# Environment
NODE_ENV=development

# UI Configuration
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_METRICS=true
NEXT_PUBLIC_SHOW_CHAT_HISTORY=true
