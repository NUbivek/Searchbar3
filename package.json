{
 "name": "searchbar3-unified",
 "private": true,
 "workspaces": ["apps/web"],
 "scripts": {
 "build": "npm run web-build",
 "web-dev": "cd apps/web && npm run dev",
 "web-build": "cd apps/web && npm run build",
 "db-up": "docker compose -f infra/db/docker-compose.yml up -d",
 "db-migrate": "for f in infra/db/migrations/*.sql; do psql $DATABASE_URL -f $f; done",
 "ingest-local": "cd services/startup_watch && python startup_watch/startup_watch.py --config startup_watch/config.yaml",
 "ingest-ci": "cd services/startup_watch && python startup_watch/startup_watch.py --config startup_watch/config.github.yaml",
 "test-python": "cd services/startup_watch && python -m pytest tests/ -x -q",
 "test-web": "cd apps/web && npm test",
 "lint-python": "cd services/startup_watch && python -m flake8 startup_watch/ --max-line-length=100",
 "lint-web": "cd apps/web && npm run lint"
 }
}
