{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(curl *)",
      "Bash(python3 *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(vercel ls*)",
      "Bash(vercel inspect*)",
      "Bash(vercel logs*)",
      "Bash(vercel whoami*)"
    ],
    "ask": [
      "Bash(git push *main*)",
      "Bash(git merge *)",
      "Bash(gh pr merge*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy*)",
      "Bash(vercel promote*)",
      "Bash(vercel env*)",
      "Bash(vercel link*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(vercel env pull*)",
      "Bash(vercel remove*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  }
}
