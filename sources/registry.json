[
  {
    "id": "A-HN-ALGOLIA",
    "name": "Hacker News Algolia",
    "region": "Global",
    "category": "startup_news",
    "thesis_tags": ["software", "ai", "developer_tools"],
    "stage_bias": ["pre-seed", "seed"],
    "method": {
      "type": "api",
      "url": "https://hn.algolia.com/api/v1/search_by_date?tags=story&query={{query}}"
    },
    "cadence": {
      "tier": "A",
      "frequency": "daily"
    },
    "query_strategy": {
      "type": "search_api"
    },
    "requires_auth": false,
    "adapter": "hn_algolia",
    "notes": "Use Algolia HN API for recent startup-related stories."
  },
  {
    "id": "A-TC-RSS",
    "name": "TechCrunch Feed",
    "region": "Global",
    "category": "startup_news",
    "thesis_tags": ["software", "venture", "startups"],
    "stage_bias": ["seed", "series_a"],
    "method": {
      "type": "rss",
      "url": "https://techcrunch.com/feed/",
      "extract": {
        "titleTag": "title",
        "urlTag": "link",
        "contentTag": "description",
        "publishedAtTag": "pubDate",
        "limit": 15
      }
    },
    "cadence": {
      "tier": "A",
      "frequency": "daily"
    },
    "query_strategy": {
      "type": "feed"
    },
    "requires_auth": false,
    "adapter": "rss",
    "notes": "General startup and funding feed."
  },
