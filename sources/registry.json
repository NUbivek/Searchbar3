  {
    "id": "B-YC-COMPANIES",
    "name": "Y Combinator Companies",
    "region": "Global",
    "category": "accelerator_directory",
    "thesis_tags": ["software", "ai", "logistics"],
    "stage_bias": ["seed", "series_a"],
    "method": {
      "type": "html",
      "url": "https://www.ycombinator.com/companies?query={{query}}",
      "extract": {
        "itemSelector": "a[href*=\"/companies/\"]",
        "excludePatterns": ["/about", "/jobs", "/requests"],
        "limit": 20
      }
    },
    "cadence": {
      "tier": "B",
      "frequency": "weekly"
    },
    "query_strategy": {
      "type": "list_page"
    },
    "requires_auth": false,
    "adapter": "html_list",
    "notes": "Use company directory listing as an open startup source."
  },
