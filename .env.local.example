# Copy to .env.local. Every variable is optional: with none set, the curated
# registry, Hacker News and SEC EDGAR still work, answers are quoted from
# sources, and local history uses an embedded database in .data/.
# GET /api/debug/env-check shows which of these are set (names only).

# ---- AI answers (free first; src/server/llm/providers.js) ----
# Groq: https://console.groq.com/keys (free tier, tried first)
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys (only ":free" models are used)
OPENROUTER_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey (free only while the
# key's Google project has no billing account)
GOOGLE_AI_API_KEY=
# Together is paid and off by default: only used when LLM_ALLOW_PAID=true
TOGETHER_API_KEY=
LLM_ALLOW_PAID=false

# ---- Search ----
# Web and news search, and every site-restricted source (LinkedIn, X, Reddit,
# Substack, Medium, Crunchbase, Pitchbook, Carta). Serper is primary, Tavily
# the fallback; one is enough.
SERPER_API_KEY=
TAVILY_API_KEY=
# Market data for public companies (Verified source, company profile)
FMP_API_KEY=
# Litigation search in Founder Check (free CourtListener account)
COURTLISTENER_API_TOKEN=

# ---- Accounts and storage ----
# Google sign-in (NextAuth). Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; required in production
NEXTAUTH_SECRET=
# The site URL in production, e.g. https://research.example.com
# (defaults to the dev server's port in development)
NEXTAUTH_URL=
# Neon Postgres in production (Vercel's Neon integration sets it). Leave
# empty locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# ---- Watchlists ----
# Vercel cron calls /api/cron/watchlists with "Authorization: Bearer <secret>"
CRON_SECRET=
# Optional email digests of new alerts (Resend free tier)
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# ---- Network Map sign-in ----
# LinkedIn app (OpenID Connect: openid, profile, email). Redirect URL:
# <site>/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X app, OAuth 2.0 Client ID/Secret (not the v1.1 API key). Redirect URL:
# <site>/api/auth/twitter/callback. Following lists need a paid X API tier.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---- OAuth callback URLs ----
# Callback URLs are derived from the request host. Override per provider:
# LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback
# To use callbacks registered for production while developing locally:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_URL=
NEXT_PUBLIC_USE_PRODUCTION_CALLBACKS=false

# Local development only: offer a "Local test user" sign-in on localhost (never in production)
ALLOW_DEV_LOGIN=false
